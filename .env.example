GARAGE_CONN_HOST_PORT=3900
GARAGE_ADMIN_HOST_PORT=3903
GARAGE_WEBUI_HOST_PORT=3909

# 32 bit random hexadecimal
GARAGE_RPC_SECRET=garagerpcsecretgaragerpcsecretgaragerpcsecretgaragerpcsecretgara

GARAGE_ADMIN_SECRET=superadminsecret
GARAGE_ADMIN_TOKEN=superadmintoken

# 16 bit random hexadecimal
GARAGE_DEFAULT_ACCESS_KEY=garagedefaultaccesskeygaragedefa
# 32 bit random hexadecimal
GARAGE_DEFAULT_SECRET_KEY=garagedefaultsecretkeygaragedefaultsecretkeygaragedefaultsecretk

# Buckets garage-init ensures exist (space-separated)
GARAGE_BUCKETS="bronze silver gold"

GARAGE_ENDPOINT=http://garage:3900
GARAGE_REGION=garage

# USGS Water Data API key. Sign up at https://api.waterdata.usgs.gov and rotate
# the key whenever it may have been exposed.
USGS_API_KEY=

# S3 / Garage settings used by the ingestion flows
S3_ENDPOINT_URL=http://garage:3900
S3_REGION=garage
S3_BUCKET_BRONZE=bronze

# Ingestion defaults
# Historical start date per data source (UTC, YYYY-MM-DD)
USGS_HISTORIC_START_DATE=2015-10-01
OPEN_METEO_HISTORIC_START_DATE=2015-10-01
# Dates without source data older than this many days are written as empty partitions so they are not retried forever. Recent empty dates are retried.
EMPTY_GRACE_DAYS=1
# Each ingest_date partition contains that day plus this many previous days.
LOOKBACK_DAYS=0
STATIONS=USGS-11525670,USGS-11150500,USGS-11454000

PREFECT_HOST_IP=4200

HOST_IP=127.0.0.1
