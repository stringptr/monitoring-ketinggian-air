GARAGE_CONN_HOST_PORT=3900
GARAGE_ADMIN_HOST_PORT=3903
GARAGE_WEBUI_HOST_PORT=3909

# Garage RPC secret: 32 bytes as 64 hex characters.
# Generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Admin API bearer token (any sufficiently random string).
GARAGE_ADMIN_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
GARAGE_ADMIN_TOKEN=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Garage access key: "GK" followed by 32 hex characters.
# Generate with: echo "GK$(openssl rand -hex 16)"
GARAGE_DEFAULT_ACCESS_KEY=GK0123456789abcdef0123456789abcdef
# Garage secret key: 32 bytes as 64 hex characters.
# Generate with: openssl rand -hex 32
GARAGE_DEFAULT_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Buckets garage-init ensures exist (space-separated)
GARAGE_BUCKETS="bronze silver gold"

GARAGE_ENDPOINT=http://garage:3900
GARAGE_REGION=garage

# USGS Water Data API key. Sign up at https://api.waterdata.usgs.gov and rotate
# the key whenever it may have been exposed.
USGS_API_KEY=

# S3 / Garage settings used by the ingestion flows
S3_ENDPOINT_URL=http://garage:3900
S3_REGION=garage
S3_BUCKET_BRONZE=bronze

# Ingestion defaults
# Historical start date per data source (UTC, YYYY-MM-DD)
USGS_HISTORIC_START_DATE=2015-10-01
OPEN_METEO_HISTORIC_START_DATE=2015-10-01
# Dates without source data older than this many days are written as empty
# partitions so they are not retried forever. Recent empty dates are retried.
# Keep this above the usual publication delay of the source, otherwise a
# temporary outage is frozen as an empty partition.
EMPTY_GRACE_DAYS=5
# Each ingest_date partition contains that day plus this many previous days.
LOOKBACK_DAYS=0
STATIONS=USGS-11525670,USGS-11150500,USGS-11454000

PREFECT_HOST_IP=4200

HOST_IP=127.0.0.1

# Silver layer
# Output bucket for the native-resolution silver tables, DQ and quarantine.
S3_BUCKET_SILVER=silver
# Number of UTC ingest_date partitions reprocessed by every daily run.
# Must cover the gold window (7 days) plus gold's 168-hour feature lookback,
# otherwise gold starts with incomplete rolling features after a gap. The
# initial backfill ignores this and uses the historic start date above.
SILVER_LOOKBACK_DAYS=14
# Soft data-quality thresholds. Schema and duplicate checks always hard-fail.
SILVER_USGS_COMPLETENESS_MIN=0.90
SILVER_METEO_COMPLETENESS_MIN=0.95
SILVER_MAX_GAP_HOURS=3
SILVER_FRESHNESS_DAYS=2
# Optional Spark overrides for the local worker.
SPARK_MASTER=local[2]
SPARK_SHUFFLE_PARTITIONS=16

# Gold layer
# Hourly dataset joined from silver, plus model features, predictions and DQ.
S3_BUCKET_GOLD=gold
# Number of UTC dates rebuilt by every daily run (late silver fills).
GOLD_LOOKBACK_DAYS=7
# Longest feature window; gold reads this much silver history before the window.
GOLD_FEATURE_LOOKBACK_HOURS=168
# Minimum share of rows that must be usable for training.
GOLD_MIN_TRAINABLE_RATIO=0.85
# auto | hourly | daily. Daily is the fallback while 00060 is ingested per day.
GOLD_DISCHARGE_SOURCE=auto

# Dashboard (Streamlit)
DASHBOARD_HOST_PORT=8501
# Only used when S3_ENDPOINT_URL is empty (reads file:/// data instead).
GOLD_LOCAL_DIR=/prefect/data/gold

# MLflow (local smoke; on Azure point this to the managed tracking server)
MLFLOW_HOST_PORT=5050
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=hydrology-gold
# Smoke only: allow the running water year into training.
TRAIN_INCLUDE_PARTIAL=false

